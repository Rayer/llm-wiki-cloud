FROM golang:1.26-alpine AS build

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -ldflags="-s -w" -o /export_worker ./cmd/export_worker

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /export_worker /export_worker
ENTRYPOINT ["/export_worker"]
