#!/usr/bin/env bash
set -eu
root="$FIXTURE_ROOT"
scenario="$(<"$root/scenario")"
args="$*"
args="${args//vercel-fixture-token/[REDACTED]}"
printf 'vercel %s\n' "$args" >> "$root/cli-calls"
event() { printf '%s\n' "$1" >> "$root/provider-events"; }
assert_repo_root() { [[ "$PWD" == "${EXPECTED_REPO_ROOT:?}" ]] || exit 98; }
case "${1:-}" in
  pull)
    event pull
    assert_repo_root
    shift
    while (($#)); do
      case "$1" in
        --yes|--environment=*) shift ;;
        --scope|--token) shift 2 ;;
        *) exit 96 ;;
      esac
    done
    [[ "${VERCEL_ORG_ID:-}" == "${VERCEL_TEAM_ID:-}" && -n "${VERCEL_ORG_ID:-}" ]] || exit 95
    [[ -f "$root/npm-ci" ]] || exit 91
    [[ "$args" == *"--environment=preview"* || "$args" == *"--environment=production"* ]] || exit 92
    touch "$root/vercel-pull"
    ;;
  build)
    event build
    assert_repo_root
    [[ "${VERCEL_ORG_ID:-}" == "${VERCEL_TEAM_ID:-}" && -n "${VERCEL_ORG_ID:-}" ]] || exit 95
    [[ -f "$root/vercel-pull" ]] || exit 93
    touch "$root/vercel-build"
    ;;
  deploy)
    event deploy
    assert_repo_root
    [[ "${VERCEL_ORG_ID:-}" == "${VERCEL_TEAM_ID:-}" && -n "${VERCEL_ORG_ID:-}" ]] || exit 95
    [[ -f "$root/vercel-build" && "$*" == *"--prebuilt"* ]] || exit 94
    [[ "$scenario" != deploy-timeout && "$scenario" != deploy-timeout-after-acceptance && "$scenario" != deploy-timeout-absent && "$scenario" != deploy-timeout-duplicate && "$scenario" != deploy-timeout-conflicting && "$scenario" != deploy-timeout-full-missing-pagination && "$scenario" != deploy-timeout-arbitrary-host && "$scenario" != deploy-timeout-canonical-host ]] || exit 28
    touch "$root/vercel-deployed"
    printf '%s\n' '{"id":"dpl_frontendnew","url":"frontend-hash.vercel.app"}'
    ;;
  *)
    printf 'unexpected Vercel command\n' >&2
    exit 90
    ;;
esac
