{
  "auth": {
    "revision": 2,
    "module_path": "github.com/rayer/gateauth",
    "source_root": "gateauth",
    "package": "./cmd/auth",
    "image": "llm-wiki-auth",
    "inputs": [
      "gateauth/Dockerfile",
      "gateauth/cloudbuild.yaml",
      "gateauth/VERSION"
    ]
  },
  "bff": {
    "revision": 1,
    "package": "./cmd/bff",
    "image": "llm-wiki-bff",
    "inputs": [
      "apps/bff/Dockerfile",
      "apps/bff/cloudbuild-bff.yaml",
      "apps/bff/VERSION",
      "apps/bff/configs/query",
      "apps/bff/scripts/postprocess_swagger.py",
      "apps/bff/cmd/versioncheck"
    ]
  },
  "worker": {
    "revision": 1,
    "package": "./cmd/olw_worker",
    "image": "olw-pipeline",
    "inputs": [
      "apps/bff/cmd/olw_worker/Dockerfile",
      "apps/bff/cmd/olw_worker/validate_build_nonce.sh"
    ]
  },
  "exportjob": {
    "revision": 1,
    "package": "./cmd/export_worker",
    "image": "llm-wiki-bff-export-job",
    "inputs": [
      "apps/bff/Dockerfile.exportjob"
    ]
  },
  "documentimport": {
    "revision": 1,
    "package": "./cmd/document_import_worker",
    "image": "llm-wiki-document-import-worker",
    "inputs": [
      ".gcloudignore",
      "apps/document-import-worker",
      "apps/bff/cloudbuild-document-import-worker.yaml"
    ]
  },
  "frontend": {
    "revision": 1,
    "inputs": [
      "apps/frontend"
    ],
    "cli": "59.11.7"
  }
}
