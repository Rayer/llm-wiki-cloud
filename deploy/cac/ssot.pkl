  pipeline_worker_service_account = "lwc-pipeline-prod@llm-wiki-cloud.iam.gserviceaccount.com"
  pipeline_schedule = prodPipelineSchedule
  llm = new BffLlm {
    provider = selected.llm.provider
    base_url = selected.llm.endpoint
    request_timeout_seconds = 60
    model = selected.llm.model
  }
  query = new BffQueryConfig {
    stage_config_path = "apps/bff/configs/query/dev/query-dev-2026-09-12.1.json"
    legacy = null
  }
  mcp = new BffMcpConfig {
    instructions = mcpInstructions
    tool_descriptions = mcpToolDescriptions
    discovery_ttl_ms = 300000
    tools_list_ttl_ms = 300000
  }
  `local` = null
  port_default = 8080
  config_secret_resource = "projects/llm-wiki-cloud/secrets/lwc-bff-config-prod"
