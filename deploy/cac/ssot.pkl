/// Project-wide settings consumed by the Pipeline and BFF target renderers.
module lwc.pipeline.ssot

environment: "local" | "dev" | "prod" = read("prop:environment")
target: "pipeline" | "bff" | "auth" = read?("prop:target") ?? "pipeline"

/// Required only when the Pipeline target is selected.
runTimeoutSeconds: Int? = read?("prop:runTimeoutSeconds")?.toInt()
pipelineArticleMaxTokens: Int? = read?("prop:pipelineArticleMaxTokens")?.toInt()

class SecretBinding {
  source: "environment" | "secret-manager"
  target: "DEEPSEEK_API_KEY"
  envName: String?
  resource: String?
}

class BffSecretReference {
  source: "environment" | "secret-manager" | "file"
  env_name: String?
  resource: String?
}

class LlmProfile {
  provider: String
  endpoint: String
  model: String
  requestTimeoutSeconds: Int
  secret: SecretBinding
}

class EnvironmentConfig {
  llm: LlmProfile
  bucket: String?
  articleMaxTokens: Int?
  pipelineCooldownSeconds: Int
}

class Environments {
  `local`: EnvironmentConfig
  dev: EnvironmentConfig
  prod: EnvironmentConfig
}

class QueryLegacy {
  query_expansion_model: String
  query_expansion_reasoning: String
  answer_synthesis_model: String
  answer_synthesis_reasoning: String
  query_selection_limit: Int
  query_selection_exploration_slots: Int
  query_selection_evidence_threshold: Int
  query_expansion_keywords_per_attempt: Int
  query_expansion_attempts: Int
  query_matching_rare_keyword_max_document_frequency: Int
}

class BffLlm {
  provider: String
  base_url: String
  request_timeout_seconds: Int
  model: String
}

class LocalBffConfig {
  scope: String
  worker_path: String
  pipeline_config_path: String
  pipeline_bindings_path: String
}

class BffQueryConfig {
  stage_config_path: String
  legacy: QueryLegacy?
}

class BffConfig {
  schema_version: Int
  environment: String
  target: String
  gcp_project: String
  bucket: String
  firestore_database_id: String
  auth_service_url: String
  pipeline_job_url: String
  export_job_url: String
  export_signing_service_account: String
  allowed_origins: Listing<String>
  allowed_hosts: Listing<String>
  pipeline_daily_limit: Int
  pipeline_cooldown_seconds: Int
  pipeline_min_new_raw: Int
  pipeline_demo_user_ids: Listing<String>
  auth_session_environment: String
  auth_session_migration: "disabled" | "legacy_read_through"
  registration_enabled: Boolean?
  jwt_secret_reference: BffSecretReference
  deepseek_api_key_reference: BffSecretReference
  typesafe_api_key_reference: BffSecretReference?
  profile_runtime_audience: String
  profile_runtime_service_account: String
  llm: BffLlm
  query: BffQueryConfig
  `local`: LocalBffConfig?
  port_default: Int
  config_secret_resource: String
}

class AuthGoogleConfig {
  enabled: Boolean
  client_id: String
  client_secret_reference: String
  issuer: String
  jwks_url: String
  token_url: String
  login_redirect_url: String
  link_redirect_url: String
  completion_url: String
}

class AuthConfig {
  schema_version: Int
  environment: String
  target: String
  gcp_project: String
  firestore_database_id: String
  local_cloud_scope: String
  auth_service_url: String
  sync_service_url: String
  allowed_hosts: Listing<String>
  allowed_origins: Listing<String>
  auth_session_environment: String
  auth_session_migration: "disabled" | "legacy_read_through"
  registration_enabled: Boolean?
  auth_demo_user_id: String
  auth_demo_user_email: String
  auth_demo_user_role: String
  jwt_secret_reference: String
  google: AuthGoogleConfig
  config_secret_resource: String
}

local localSecretResource: String? = read?("prop:localSecretVersionResource")
local localBffScope = read?("prop:bffLocalScope") ?? ""
local localBffWorkerPath = read?("prop:bffLocalWorkerPath") ?? ""
local localBffPipelineConfigPath = read?("prop:bffLocalPipelineConfigPath") ?? ""
local localBffPipelineBindingsPath = read?("prop:bffLocalPipelineBindingsPath") ?? ""
local localBffJWTSecretFile = read?("prop:bffLocalJWTSecretFile") ?? ""
local localBffDemoUserIDs = read?("prop:bffLocalDemoUserIDs") ?? ""
local localBffPort = (read?("prop:bffLocalPort") ?? "8080").toInt()
local localBffAuthPort = (read?("prop:bffLocalAuthPort") ?? "8081").toInt()
local localBffFrontendPort = (read?("prop:bffLocalFrontendPort") ?? "3000").toInt()
local localAuthScope = read?("prop:authLocalScope") ?? ""
local localAuthJWTSecretFile = read?("prop:authLocalJWTSecretFile") ?? ""
local localAuthDemoUserID = read?("prop:authLocalDemoUserID") ?? ""
local localAuthDemoUserEmail = read?("prop:authLocalDemoUserEmail") ?? ""
local localAuthDemoUserRole = read?("prop:authLocalDemoUserRole") ?? ""
local localAuthPort = (read?("prop:authLocalAuthPort") ?? "8081").toInt()

local deepseekSecret = new SecretBinding {
  source = "secret-manager"
  target = "DEEPSEEK_API_KEY"
  envName = null
  resource = "projects/llm-wiki-cloud/secrets/deepseek-apikey/versions/latest"
}

local deepseek = new LlmProfile {
  provider = "deepseek"
  endpoint = "https://api.deepseek.com/v1"
  model = "deepseek-flash"
  requestTimeoutSeconds = 600
  secret = deepseekSecret
}

local deepseekLocal = (deepseek) {
  secret = new SecretBinding {
    source = if (localSecretResource == null) "environment" else "secret-manager"
    target = deepseek.secret.target
    envName = if (localSecretResource == null) "LLM_API_KEY" else null
    resource = localSecretResource
  }
}

local environments = new Environments {
  `local` = new EnvironmentConfig {
    llm = deepseekLocal
    bucket = null
    articleMaxTokens = null
    pipelineCooldownSeconds = 60
  }
  dev = new EnvironmentConfig {
    llm = deepseek
    bucket = "llm-wiki-data-dev"
    articleMaxTokens = null
    pipelineCooldownSeconds = 600
  }
  prod = new EnvironmentConfig {
    llm = deepseek
    bucket = "llm-wiki-data"
    articleMaxTokens = null
    pipelineCooldownSeconds = 3600
  }
}

local selected = if (environment == "local") environments.`local`
  else if (environment == "dev") environments.dev
  else environments.prod

local pipeline = new {
  environment = outer.environment
  runTimeoutSeconds = outer.runTimeoutSeconds
  bucket = selected.bucket
  articleMaxTokens = selected.articleMaxTokens ?? outer.pipelineArticleMaxTokens
  llm = selected.llm
}

local localJwtSecretReference = new BffSecretReference {
  source = "file"
  env_name = null
  resource = localBffJWTSecretFile
}

local devJwtSecretReference = new BffSecretReference {
  source = "secret-manager"
  env_name = null
  resource = "projects/llm-wiki-cloud/secrets/jwt-secret-dev/versions/latest"
}

local prodJwtSecretReference = new BffSecretReference {
  source = "secret-manager"
  env_name = null
  resource = "projects/llm-wiki-cloud/secrets/jwt-secret-prod/versions/latest"
}

local localDeepSeekSecretReference = new BffSecretReference {
  source = selected.llm.secret.source
  env_name = selected.llm.secret.envName
  resource = selected.llm.secret.resource
}

local devTypeSafeSecretReference = new BffSecretReference {
  source = "secret-manager"
  env_name = null
  resource = "projects/llm-wiki-cloud/secrets/typesafe-jev-api-key-dev/versions/1"
}

local prodTypeSafeSecretReference = new BffSecretReference {
  source = "secret-manager"
  env_name = null
  resource = "projects/llm-wiki-cloud/secrets/typesafe-jev-api-key-prod/versions/1"
}

local localBff = new BffConfig {
  schema_version = 2
  environment = "local"
  target = "bff"
  gcp_project = "llm-wiki-cloud"
  bucket = "llm-wiki-cloud-local"
  firestore_database_id = "llm-wiki-cloud-local"
  auth_service_url = "http://localhost:\(localBffAuthPort)"
  pipeline_job_url = "https://run.googleapis.com/v2/projects/llm-wiki-cloud/locations/asia-east1/jobs/olw-pipeline:run"
  export_job_url = ""
  export_signing_service_account = ""
  allowed_origins = new Listing {
    "http://localhost:\(localBffFrontendPort)"
  }
  allowed_hosts = new Listing {
    "localhost"
    "127.0.0.1"
  }
  pipeline_daily_limit = 2
  pipeline_cooldown_seconds = selected.pipelineCooldownSeconds
  pipeline_min_new_raw = 1
  pipeline_demo_user_ids = if (localBffDemoUserIDs == "") new Listing {} else localBffDemoUserIDs.split(",")
  auth_session_environment = "llm-wiki-cloud-local"
  auth_session_migration = "disabled"
  registration_enabled = null
  jwt_secret_reference = localJwtSecretReference
  deepseek_api_key_reference = localDeepSeekSecretReference
  typesafe_api_key_reference = null
  profile_runtime_audience = ""
  profile_runtime_service_account = ""
  llm = new BffLlm {
    provider = selected.llm.provider
    base_url = selected.llm.endpoint
    request_timeout_seconds = 60
    model = selected.llm.model
  }
  query = new BffQueryConfig {
    stage_config_path = ""
    legacy = new QueryLegacy {
      query_expansion_model = "deepseek-flash"
      query_expansion_reasoning = "none"
      answer_synthesis_model = "deepseek-flash"
      answer_synthesis_reasoning = "none"
      query_selection_limit = 10
      query_selection_exploration_slots = 1
      query_selection_evidence_threshold = 2
      query_expansion_keywords_per_attempt = 24
      query_expansion_attempts = 3
      query_matching_rare_keyword_max_document_frequency = 1
    }
  }
  `local` = new LocalBffConfig {
    scope = localBffScope
    worker_path = localBffWorkerPath
    pipeline_config_path = localBffPipelineConfigPath
    pipeline_bindings_path = localBffPipelineBindingsPath
  }
  port_default = localBffPort
  config_secret_resource = ""
}

local devBff = new BffConfig {
  schema_version = 2
  environment = "dev"
  target = "bff"
  gcp_project = "llm-wiki-cloud"
  bucket = "llm-wiki-data-dev"
  firestore_database_id = "llm-wiki-cloud-dev"
  auth_service_url = "https://auth.dev.rayer.idv.tw"
  pipeline_job_url = "https://run.googleapis.com/v2/projects/llm-wiki-cloud/locations/asia-east1/jobs/olw-pipeline-dev:run"
  export_job_url = "https://run.googleapis.com/v2/projects/llm-wiki-cloud/locations/asia-east1/jobs/export-job-dev:run"
  export_signing_service_account = "lwc-export-signer-dev@llm-wiki-cloud.iam.gserviceaccount.com"
  allowed_origins = new Listing {
    "https://wiki.dev.rayer.idv.tw"
    "https://llm-wiki-frontend-dev.vercel.app"
    "http://localhost:3000"
    "http://127.0.0.1:3000"
  }
  allowed_hosts = new Listing {}
  pipeline_daily_limit = 2
  pipeline_cooldown_seconds = selected.pipelineCooldownSeconds
  pipeline_min_new_raw = 1
  pipeline_demo_user_ids = new Listing { "e492f6bdaf1735e12b2de96d" }
  auth_session_environment = "llm-wiki-cloud-dev"
  auth_session_migration = "disabled"
  registration_enabled = null
  jwt_secret_reference = devJwtSecretReference
  deepseek_api_key_reference = new BffSecretReference {
    source = "secret-manager"
    env_name = null
    resource = deepseek.secret.resource
  }
  typesafe_api_key_reference = devTypeSafeSecretReference
  profile_runtime_audience = "https://llm-wiki-bff-dev-a5nkmux6pq-de.a.run.app"
  profile_runtime_service_account = "lwc-bff-dev@llm-wiki-cloud.iam.gserviceaccount.com"
  llm = new BffLlm {
    provider = selected.llm.provider
    base_url = selected.llm.endpoint
    request_timeout_seconds = 60
    model = selected.llm.model
  }
  query = new BffQueryConfig {
    stage_config_path = "apps/bff/configs/query/dev/query-dev-2026-09-12.1.json"
    legacy = null
  }
  `local` = null
  port_default = 8080
  config_secret_resource = "projects/llm-wiki-cloud/secrets/lwc-bff-config-dev"
}

local prodBff = new BffConfig {
  schema_version = 2
  environment = "prod"
  target = "bff"
  gcp_project = "llm-wiki-cloud"
  bucket = "llm-wiki-data"
  firestore_database_id = "llm-wiki-cloud-prod"
  auth_service_url = "https://auth.rayer.idv.tw"
  pipeline_job_url = "https://run.googleapis.com/v2/projects/llm-wiki-cloud/locations/asia-east1/jobs/olw-pipeline:run"
  export_job_url = "https://run.googleapis.com/v2/projects/llm-wiki-cloud/locations/asia-east1/jobs/export-job:run"
  export_signing_service_account = "lwc-export-signer-prod@llm-wiki-cloud.iam.gserviceaccount.com"
  allowed_origins = new Listing {
    "https://wiki.rayer.idv.tw"
    "https://llm-wiki-frontend.vercel.app"
  }
  allowed_hosts = new Listing {}
  pipeline_daily_limit = 2
  pipeline_cooldown_seconds = selected.pipelineCooldownSeconds
  pipeline_min_new_raw = 1
  pipeline_demo_user_ids = new Listing { "e492f6bdaf1735e12b2de96d" }
  auth_session_environment = "llm-wiki-cloud-prod"
  auth_session_migration = "disabled"
  registration_enabled = null
  jwt_secret_reference = prodJwtSecretReference
  deepseek_api_key_reference = new BffSecretReference {
    source = "secret-manager"
    env_name = null
    resource = deepseek.secret.resource
  }
  typesafe_api_key_reference = prodTypeSafeSecretReference
  profile_runtime_audience = "https://llm-wiki-bff-a5nkmux6pq-de.a.run.app"
  profile_runtime_service_account = "lwc-bff-prod@llm-wiki-cloud.iam.gserviceaccount.com"
  llm = new BffLlm {
    provider = selected.llm.provider
    base_url = selected.llm.endpoint
    request_timeout_seconds = 60
    model = selected.llm.model
  }
  query = new BffQueryConfig {
    stage_config_path = "apps/bff/configs/query/dev/query-dev-2026-09-12.1.json"
    legacy = null
  }
  `local` = null
  port_default = 8080
  config_secret_resource = "projects/llm-wiki-cloud/secrets/lwc-bff-config-prod"
}

local bff = if (environment == "local") localBff
  else if (environment == "dev") devBff
  else prodBff

local localAuth = new AuthConfig {
  schema_version = 1
  environment = "local"
  target = "auth"
  gcp_project = "llm-wiki-cloud"
  firestore_database_id = "llm-wiki-cloud-local"
  local_cloud_scope = localAuthScope
  auth_service_url = "http://localhost:\(localAuthPort)"
  sync_service_url = "http://localhost:\(localBffPort)"
  allowed_hosts = new Listing { "localhost"; "127.0.0.1" }
  allowed_origins = new Listing { "http://localhost:\(localBffFrontendPort)" }
  auth_session_environment = "llm-wiki-cloud-local"
  auth_session_migration = "disabled"
  registration_enabled = null
  auth_demo_user_id = localAuthDemoUserID
  auth_demo_user_email = localAuthDemoUserEmail
  auth_demo_user_role = localAuthDemoUserRole
  jwt_secret_reference = localAuthJWTSecretFile
  google = new AuthGoogleConfig {
    enabled = false
    client_id = ""
    client_secret_reference = ""
    issuer = ""
    jwks_url = ""
    token_url = ""
    login_redirect_url = ""
    link_redirect_url = ""
    completion_url = ""
  }
  config_secret_resource = ""
}

local devAuth = new AuthConfig {
  schema_version = 1
  environment = "dev"
  target = "auth"
  gcp_project = "llm-wiki-cloud"
  firestore_database_id = "llm-wiki-cloud-dev"
  local_cloud_scope = ""
  auth_service_url = "https://auth.dev.rayer.idv.tw"
  sync_service_url = "https://llm-wiki-bff-dev-580854833715.asia-east1.run.app"
  allowed_hosts = new Listing { "auth.dev.rayer.idv.tw"; "auth-dev.rayer.idv.tw" }
  allowed_origins = new Listing {
    "https://wiki.dev.rayer.idv.tw"
    "https://llm-wiki-frontend-dev.vercel.app"
    "http://localhost:3000"
  }
  auth_session_environment = "llm-wiki-cloud-dev"
  auth_session_migration = "disabled"
  registration_enabled = null
  auth_demo_user_id = "e492f6bdaf1735e12b2de96d"
  auth_demo_user_email = "demo@llm-wiki.dev"
  auth_demo_user_role = "member"
  jwt_secret_reference = "projects/llm-wiki-cloud/secrets/jwt-secret-dev/versions/latest"
  google = new AuthGoogleConfig {
    enabled = true
    client_id = "580854833715-vo7fg6f7f15g1kkgchk1ulccllbc24qg.apps.googleusercontent.com"
    client_secret_reference = "projects/llm-wiki-cloud/secrets/google-oauth-client-dev/versions/1"
    issuer = "https://accounts.google.com"
