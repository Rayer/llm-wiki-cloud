      query_expansion_keywords_per_attempt = 24
      query_expansion_attempts = 3
      query_matching_rare_keyword_max_document_frequency = 1
    }
  }
  mcp = new BffMcpConfig {
    instructions = mcpInstructions
    tool_descriptions = mcpToolDescriptions
    discovery_ttl_ms = 0
    tools_list_ttl_ms = 0
  }
  `local` = new LocalBffConfig {
    scope = localBffScope
    worker_path = localBffWorkerPath
    pipeline_config_path = localBffPipelineConfigPath
    pipeline_bindings_path = localBffPipelineBindingsPath
