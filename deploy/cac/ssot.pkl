    completion_url = "https://wiki.dev.rayer.idv.tw/login"
  }
  config_secret_resource = "projects/llm-wiki-cloud/secrets/lwc-auth-app-config-dev"
}

local prodAuth = new AuthConfig {
  schema_version = 1
  environment = "prod"
  target = "auth"
  gcp_project = "llm-wiki-cloud"
  firestore_database_id = "llm-wiki-cloud-prod"
  local_cloud_scope = ""
  auth_service_url = "https://auth.rayer.idv.tw"
  sync_service_url = "https://llm-wiki-bff-580854833715.asia-east1.run.app"
  allowed_hosts = new Listing { "auth.rayer.idv.tw" }
  allowed_origins = new Listing {
    "https://wiki.rayer.idv.tw"
    "https://llm-wiki-frontend.vercel.app"
  }
  auth_session_environment = "llm-wiki-cloud-prod"
  auth_session_migration = "disabled"
  registration_enabled = null
  auth_demo_user_id = "e492f6bdaf1735e12b2de96d"
  auth_demo_user_email = "demo@llm-wiki.dev"
  auth_demo_user_role = "member"
  jwt_secret_reference = "projects/llm-wiki-cloud/secrets/jwt-secret-prod/versions/latest"
  google = new AuthGoogleConfig {
    enabled = true
    client_id = "580854833715-1b37asap0uocbdcrighjaorflvj2n94m.apps.googleusercontent.com"
    client_secret_reference = "projects/llm-wiki-cloud/secrets/google-oauth-client-prod/versions/1"
    issuer = "https://accounts.google.com"
    jwks_url = "https://www.googleapis.com/oauth2/v3/certs"
    token_url = "https://oauth2.googleapis.com/token"
    login_redirect_url = "https://auth.rayer.idv.tw/api/v1/auth/google/callback"
    link_redirect_url = "https://auth.rayer.idv.tw/api/v1/auth/google/link/callback"
    completion_url = "https://wiki.rayer.idv.tw/login"
  }
  config_secret_resource = "projects/llm-wiki-cloud/secrets/lwc-auth-app-config-prod"
}

local auth = if (environment == "local") localAuth
  else if (environment == "dev") devAuth
  else prodAuth

output {
  value = if (target == "auth") auth else if (target == "bff") bff else pipeline
  renderer = if (target == "auth") new JsonRenderer { omitNullProperties = false } else new JsonRenderer {}
}
