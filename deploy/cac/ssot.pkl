    "https://wiki.rayer.idv.tw"
    "https://llm-wiki-frontend.vercel.app"
  }
  allowed_hosts = new Listing {}
  pipeline_daily_limit = 2
  pipeline_cooldown_seconds = selected.pipelineCooldownSeconds
  pipeline_min_new_raw = 1
  pipeline_demo_user_ids = new Listing { "e492f6bdaf1735e12b2de96d" }
  auth_session_environment = "llm-wiki-cloud-prod"
  auth_session_migration = "disabled"
  registration_enabled = null
  jwt_secret_reference = null
  auth_consumer = prodBffAuthConsumer
