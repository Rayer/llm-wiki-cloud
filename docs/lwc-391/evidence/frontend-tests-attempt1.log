                ) : (
                  <span>{t('Pipeline.pipelineStages')}</span>
                )}
              </p>
            </div>

            <ExportPanel />
          </Surface>

          {/* Toast notifications */}
          <div className="fixed bottom-4 right-4 z-50 flex flex-col gap-2">
            {toasts.map((toast) => (
              <div
                key={toast.id}
                className={`rounded-lg border px-4 py-2 text-sm shadow-lg backdrop-blur ${
