            </div>

            {/* Pipeline Info */}
            <div className="mt-3 rounded-[var(--radius-md)] border border-white/5 bg-zinc-950/40 p-3">
              <p className="flex flex-wrap items-center gap-2 text-xs text-zinc-500">
