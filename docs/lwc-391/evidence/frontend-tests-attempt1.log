              {pipelineStatus?.last_execution?.compile_mode === 'full' ? (
                <div className="mt-2 space-y-1 rounded border border-white/5 bg-zinc-950/40 p-2 text-xs text-zinc-400" data-testid="pipeline-full-evidence">
                  <p>
